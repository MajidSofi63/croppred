# Environment variables for India Crop Recommendation System
# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL connection string (required by the API and Step 4).
# Replace user, password, host, port, and database with your own values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Google Gemini API key (optional). Reasons are ALWAYS computed from
# deterministic facts; Gemini only rewrites their wording when enabled below.
GEMINI_API_KEY=
# Optional Gemini model name.
GEMINI_MODEL=gemini-3.5-flash-lite
# Set to true to let Gemini rewrite the computed reasons. Off by default
# because the extra network call adds several seconds to a recommendation.
GEMINI_ENABLED=false

# Application settings.
APP_ENV=development
LOG_LEVEL=info

